{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@gateway-experience/beauty-sdk": ["../../packages/beauty-sdk/src/index.ts"],
      "@gateway-experience/beauty-sdk/core": ["../../packages/beauty-sdk/src/core/index.ts"],
      "@gateway-experience/beauty-sdk/hooks": ["../../packages/beauty-sdk/src/hooks/index.ts"],
      "@gateway-experience/beauty-sdk/ui": ["../../packages/beauty-sdk/src/ui/index.ts"],
      "@gateway-experience/beauty-sdk/studio": ["../../packages/beauty-sdk/src/studio/index.ts"],
      "@gateway-experience/beauty-sdk/form": ["../../packages/beauty-sdk/src/studio/form/index.ts"],
      "@gateway-experience/beauty-sdk/score": ["../../packages/beauty-sdk/src/studio/score/index.ts"],
      "@gateway-experience/beauty-sdk/match": ["../../packages/beauty-sdk/src/studio/match/index.ts"],
      "@gateway-experience/beauty-sdk/reference": ["../../packages/beauty-sdk/src/studio/reference/index.ts"],
      "@gateway-experience/beauty-sdk/vision": ["../../packages/beauty-sdk/src/ui/index.ts"],
      "@gateway-experience/beauty-sdk/*": ["../../packages/beauty-sdk/src/*"]
    }
  },

  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "**/*.test.ts"]
}
