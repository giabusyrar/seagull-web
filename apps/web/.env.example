# Template for apps/web/.env.local. Copy it, then fill in the two secrets.
# Ports follow docs/PORTS.md — they are global across all three repositories.
#
#   cp apps/web/.env.example apps/web/.env.local

# --- Service resolution (lib/config/services.ts, next.config.ts) ---
# Defaults below assume everything runs on this machine. Point the gateway pair
# at a deployed gateway instead (Caddy fronts it as gw.<host> and api.<host> —
# see seagull-gateway docs/DEPLOY-SUMOPOD.md) and leave the rest on 127.0.0.1
# to run the dashboard against a remote gateway with local core services.
SERVICE_PROTOCOL=http
SERVICE_BASE_HOST=127.0.0.1

# gateway-engine: control plane, dashboard API, login. Seagull-gateway.
GATEWAY_ENGINE_URL=http://127.0.0.1:8081
# Data plane that /core/* is proxied to: APISIX, locally and deployed.
GATEWAY_PROXY_URL=http://127.0.0.1:9080
# Seagull-core services have no entries here: both core-engine and
# reference-service are reached only through the data plane above —
# /core/<module>/... and /reference/<entity> — which is also what carries the
# data-plane key.

# Browser-visible copies. Next.js inlines these at build time, so restart the
# dev server after changing them — and never put a secret in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_GATEWAY_ENGINE_URL=http://127.0.0.1:8081
NEXT_PUBLIC_GATEWAY_PROXY_URL=http://127.0.0.1:9080

# --- Backing services ---
# Upstash over TLS: rediss://default:PASSWORD@HOST.upstash.io:6379
# Same instance the gateway and core repos use.
REDIS_URL=

# --- Assessment pipeline (studio orchestrator, /api/orchestrator/pipeline) ---
# Optional. Where the server-side pipeline calls the engines; absent, it calls
# back through this app's own origin. A request can never set these: the
# gateway key is sent with the calls.
# SCORE_ENGINE_URL=
# MATCH_ENGINE_URL=
# Full URL of a capability dispatch service; absent, vision dispatches nothing.
# VISION_DISPATCH_URL=

# --- Login lockout (lib/login-rate-limit.ts) ---
# Optional; the defaults are shown. Failed logins per username within the
# window before it is locked, and for how long.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MINUTES=15
# LOGIN_LOCKOUT_MINUTES=15

# --- Secrets ---
# Key for lib/crypto.ts (read in order: ENCRYPTION_KEY, SECRET_KEY,
# APP_ENCRYPTION_KEY). Must match the gateway's ENCRYPTION_KEY, or secrets
# written by one side cannot be read by the other. Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# GATEWAY_API_KEY is deliberately absent: the dashboard sends X-API-Key per
# request (Try & Send, route and collection headers), and a key is only
# readable at creation — the gateway stores nothing but its SHA-256 hash.
# Set it only if you want a server-side default for /core/* proxying.

