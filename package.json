{
  "name": "seagull-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/simulator",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,sim -c blue,magenta \"npm:dev:web\" \"npm:dev:simulator\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:simulator": "npm run dev --workspace=apps/simulator",
    "build:packages": "npm run build -w @gateway-experience/shared && npm run build -w @gateway-experience/beauty-sdk && npm run build -w @gateway-experience/studio",
    "build:web": "npm run build --workspace=apps/web",
    "build:simulator": "npm run build --workspace=apps/simulator",
    "build": "npm run build:packages && npm run build:web",
    "test": "npm run build",
    "lint": "eslint",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "concurrently": "^9.2.4",
    "typescript": "^5.0.0"
  }
}
